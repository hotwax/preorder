VITE_I18N_LOCALE=en-US
VITE_I18N_FALLBACK_LOCALE=en-US
VITE_CACHE_MAX_AGE=3600
VITE_VIEW_SIZE=10
VITE_APP_PERMISSION_ID=PREORDER_APP_VIEW
# Multi-version app hosting config (single JSON object). buildVersion: "" = root bootstrap, "vX.Y.Z" = versioned build.
VITE_APP_VERSION_CONFIG={"appId":"PREORDER","environmentTypeId":"AppEnvDev","buildVersion":""}
VITE_DEFAULT_LOG_LEVEL=error
VITE_AUTH_BACKEND=ofbiz
VITE_MOQUI_BASE_URL=
VITE_LAUNCHPAD_URL=http://launchpad.hotwax.io/login
VITE_OMS_TYPE=
VITE_DEFAULT_PRODUCT_STORE_SETTINGS={"PRDT_IDEN_PREF":{"stateKey":"productIdentifier.productIdentificationPref","value":{"primaryId":"SKU","secondaryId":"productId"}},"BARCODE_IDEN_PREF":{"stateKey":"barcodeIdentifier.barcodeIdentifierPref","value":"SKU"},"AFFECT_QOH_ON_REJ":{"stateKey":"affectQOHOnRej","value":"N"}}


# --- Fast Travel (Cmd/Ctrl+K app switcher) ---
# Base URLs of sibling HotWax admin apps (VITE_LAUNCHPAD_URL above is also used). Blank = that app
# shows as "Not configured" in the palette for this deployment.
VITE_JOB_MANAGER_URL=
VITE_ORDER_MANAGER_URL=
VITE_ORDER_ROUTING_URL=
VITE_COMPANY_URL=
VITE_PRODUCTS_URL=

# Grafana Faro collector endpoint. Leave empty to disable sending app logs.
VITE_FARO_COLLECTOR_URL=""
# Sent as the x-api-key header; leave empty when the collector does not require one.
VITE_FARO_API_KEY=""
